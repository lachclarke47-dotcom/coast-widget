name: Build Coast Widget

on:
  push:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Unpack project
        run: unzip -o CoastWidget.zip -d src

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.9"

      - name: Build app
        working-directory: src/CoastWidget
        run: gradle assembleDebug --no-daemon

      - name: Rename
        run: cp src/CoastWidget/app/build/outputs/apk/debug/app-debug.apk CoastWidget.apk

      - name: Publish download
        uses: softprops/action-gh-release@v2
        with:
          tag_name: latest
          name: Coast Widget
          files: CoastWidget.apk
          make_latest: true
